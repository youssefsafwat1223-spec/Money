<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.youssefsafwat.mali</string>
	</array>
	<!-- MALI-031 — the shared Keychain group used by SharedCaptureStore, so the
	     Share Extension reads/writes the same device secret + capture-queue key
	     as the host app. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.youssefsafwat.mali.shared</string>
	</array>
</dict>
</plist>
