# ──────────────────────────────────────────────────────────────────────────────
# Qirsh Admin — environment template
#
# Copy to ONE of:
#   .env.development.local   → LOCAL development (recommended; see below)
#   .env.local               → the deployed project's configuration
#
# Both files are git-ignored. Never commit real keys.
# ──────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed if you add server-side admin operations
# beyond what authenticated RLS + RPC functions cover.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Local development ─────────────────────────────────────────────────────────
# Run `supabase status` against your local stack and copy its API URL and keys
# into `.env.development.local`. In development Next.js loads that file ahead of
# `.env.local`, so local values win without editing your deployed config.
#
#   NEXT_PUBLIC_SUPABASE_URL=<local API URL from `supabase status`>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<local service_role key>
#
# Then:  npm run dev:local
#
# `npm run dev` refuses to start in development when the configured URL is a
# known deployed project (production / evidence staging / validation staging).
# See lib/env-guard.ts. To override deliberately, name the exact project ref:
#
#   ADMIN_ALLOW_REMOTE_SUPABASE=<project-ref> npm run dev
