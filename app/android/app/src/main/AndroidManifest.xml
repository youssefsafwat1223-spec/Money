<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required in the MAIN manifest (not only debug/profile) — release builds
         need it for auth, Supabase sync, Edge calls, Sentry, and fonts.
         Without it every production network call fails while debug works. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Exact scheduling for streak/weekly/bill reminders (zonedSchedule uses
         exactAllowWhileIdle). USE_EXACT_ALARM covers Android 13+ alarm/reminder
         apps; SCHEDULE_EXACT_ALARM is the user-grantable fallback. Without these
         exact alarms throw on Android 14+ and reminders silently never fire. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Reschedule pending notifications after a device reboot (the
         flutter_local_notifications boot receiver needs this permission). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         MALI-013 — OPTIONAL automatic bank-SMS capture.

         RECEIVE_SMS is a Google Play RESTRICTED permission. This build is
         Play-safe by DEFAULT: the permission and the SmsCaptureReceiver below
         are COMMENTED OUT, so the shipping manifest declares no SMS access and
         capture works entirely through "Share to Mali" (durable, no permission).

         Automatic capture is fully implemented (SmsCaptureReceiver +
         DurableCaptureQueue + CaptureSettings, opt-in and OFF by default). To
         ship it you MUST, at the BUILD/MANIFEST level (not a runtime flag):
           1. Obtain a Google Play Console Permissions Declaration approval for
              "SMS-based money management" AND add the required prominent
              in-app disclosure before the runtime permission request.
           2. Uncomment the RECEIVE_SMS permission and the receiver block below
              (or move them into a dedicated `smsCapture` product flavor so the
              default/Play-safe build never declares them).
         Do NOT uncomment without (1) — a declared RECEIVE_SMS without approval
         gets the app rejected/removed.

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- MALI-033 — Android Auto Backup / device-transfer policy.
         The entire local dataset is Keystore-bound and would restore INCOHERENT
         under platform backup:
           • SQLCipher DB `money_companion.sqlite` — encrypted with a key held in
             flutter_secure_storage (Android Keystore). Auto Backup never restores
             the Keystore key, so a restored DB is permanently undecryptable.
           • SharedPreferences `mali_capture_queue_v1` — raw captured bank-SMS
             queue (user-owned sensitive data); must not survive onto another
             device/user (Phase-2 cross-user guarantee).
           • SharedPreferences `mali_capture_settings_v1` — capture opt-in flag;
             restoring "capture enabled" onto a new device without the permission
             flow is incoherent.
           • SharedPreferences `FlutterSecureStorage` — Keystore-wrapped secrets
             (DB key, device secret); undecryptable after restore.
         There is no coordinated key-restoration path, so platform backup is
         disabled entirely. Financial-data recovery is via the app's OWN
         passphrase-encrypted cloud backup (backup_snapshot_builder /
         restore_backup_usecase), not Android Auto Backup. -->
    <application
        android:label="قرش"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/launcher_icon">
        <meta-data
            android:name="com.dexterous.flutterlocalnotifications.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications receivers. The plugin's library manifest
             does NOT declare these (only its example does), so the host app must:
             - ScheduledNotificationReceiver: fires zonedSchedule notifications
               (without it, scheduled reminders never appear on Android).
             - ScheduledNotificationBootReceiver: reschedules them after reboot.
             - ActionBroadcastReceiver: routes notification action buttons
               (Confirm/Dismiss) to the background handler. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- MALI-013 automatic-SMS receiver — enable ONLY with Play approval
             (see the RECEIVE_SMS note above). Commented out for the Play-safe
             default build; the implementation (SmsCaptureReceiver) is ready.
        <receiver
            android:name=".SmsCaptureReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        -->

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
