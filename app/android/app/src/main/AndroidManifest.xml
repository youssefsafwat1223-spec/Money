<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required in the MAIN manifest (not only debug/profile) — release builds
         need it for auth, Supabase sync, Edge calls, Sentry, and fonts.
         Without it every production network call fails while debug works. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- MALI-068n §9 — streak/weekly/bill reminders TOLERATE inexact delivery,
         so we schedule with inexactAllowWhileIdle and deliberately do NOT
         request the Play-policy-restricted USE_EXACT_ALARM / SCHEDULE_EXACT_ALARM
         permissions. Inexact alarms never throw and need no runtime grant, so a
         reminder is never silently lost for want of exact-alarm access. If a
         genuinely time-critical alarm is ever needed, add the permission with a
         documented eligible use case and a runtime-capability fallback. -->
    <!-- Reschedule pending notifications after a device reboot (the
         flutter_local_notifications boot receiver needs this permission). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         MALI-013 — automatic financial-SMS capture. CORE Qirsh V1 feature.

         RECEIVE_SMS is a Google Play RESTRICTED permission. It is declared here
         because automatic expense tracking from bank SMS is the app's core
         purpose, which is the basis of the permitted exception:

             Play policy exception: "SMS-based money management"

         PUBLICATION IS GATED on an approved Play Permissions Declaration. Until
         that approval lands the app must not be published to production. See
         Qirsh Production/18_Android_SMS_Capture/.

         Deliberately NOT declared, because the implementation does not use them:
           • READ_SMS          — the receiver reads broadcast intents only, never
                                 content://sms. Asking for inbox history we never
                                 read would enlarge the declaration for nothing.
           • SEND_SMS / WRITE_SMS / RECEIVE_MMS / RECEIVE_WAP_PUSH — no feature
                                 requires them.

         Runtime behaviour is a TWO-KEY LOCK: the permission being granted is not
         consent. CaptureSettings.autoCaptureEnabled must also be ON, set by the
         user after a prominent disclosure. Revoking the OS permission fails the
         capture closed on the next check.
         ═══════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- MALI-033 — Android Auto Backup / device-transfer policy.
         The entire local dataset is Keystore-bound and would restore INCOHERENT
         under platform backup:
           • SQLCipher DB `money_companion.sqlite` — encrypted with a key held in
             flutter_secure_storage (Android Keystore). Auto Backup never restores
             the Keystore key, so a restored DB is permanently undecryptable.
           • SharedPreferences `mali_capture_queue_v1` — raw captured bank-SMS
             queue (user-owned sensitive data); must not survive onto another
             device/user (Phase-2 cross-user guarantee).
           • SharedPreferences `mali_capture_settings_v1` — capture opt-in flag;
             restoring "capture enabled" onto a new device without the permission
             flow is incoherent.
           • SharedPreferences `FlutterSecureStorage` — Keystore-wrapped secrets
             (DB key, device secret); undecryptable after restore.
         There is no coordinated key-restoration path, so platform backup is
         disabled entirely. Financial-data recovery is via the app's OWN
         passphrase-encrypted cloud backup (backup_snapshot_builder /
         restore_backup_usecase), not Android Auto Backup. -->
    <application
        android:label="قرش"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/launcher_icon">
        <meta-data
            android:name="com.dexterous.flutterlocalnotifications.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- AdMob (R4/R7). Resolved from the `admobAppId` manifest placeholder,
             which Gradle sets to Google's public TEST app id for debug and to
             ADMOB_APP_ID_ANDROID (env or Gradle property) for release. No
             literal production id is committed. No IDFA/ATT is requested. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications receivers. The plugin's library manifest
             does NOT declare these (only its example does), so the host app must:
             - ScheduledNotificationReceiver: fires zonedSchedule notifications
               (without it, scheduled reminders never appear on Android).
             - ScheduledNotificationBootReceiver: reschedules them after reboot.
             - ActionBroadcastReceiver: routes notification action buttons
               (Confirm/Dismiss) to the background handler. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- MALI-013 automatic-SMS receiver.

             Manifest-declared, not runtime-registered: the system must be able
             to start it when the app's process is not running, which is the
             whole point of automatic capture.

             android:permission="android.permission.BROADCAST_SMS" means only the
             OS can deliver here — no other app can inject a fake bank SMS. -->
        <receiver
            android:name=".SmsCaptureReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
